      <li><a href="/catalog?f%5Bcollection_tsim_str%5D%5B%5D=Serials+%7C+Publications+en+se%CC%81rie&amp;q=&amp;search_field=all_fields&amp;lang=<%= I18n.locale %>">Publications en s&eacute;rie</a></li>
      <li><a href="/catalog?f%5Bcollection_tsim_str%5D%5B%5D=Government+Publications+%7C+Publications+gouvernementales&amp;q=&amp;search_field=all_fields&amp;lang=<%= I18n.locale %>">Publications gouvernementales</a></li>
      <li><a href="/catalog?f%5Bcollection_tsim_str%5D%5B%5D=Maps+%7C+Cartes&amp;q=&amp;search_field=all_fields&amp;lang=<%= I18n.locale %>">Cartes</a></li>
    </ul>

    <div class="d-flex flex-wrap gap-2 mt-3">
