<div class="home-page">
  <section class="site-section home-intro home-intro--canadiana-clean">
    <div class="canadiana-shell home-canadiana-intro-grid">
      <div class="home-canadiana-intro-copy">
        <h1 class="section-title">Collection Canadiana</h1>
        <p class="section-lede">
          Environ 31&nbsp;millions de pages de publications qui montrent comment les connaissances, les r&eacute;cits et l&apos;information
          ont circul&eacute; au fil du temps. Cette collection comprend des livres, journaux, magazines, documents gouvernementaux,
          cartes et plus encore, de 1500 &agrave; aujourd&apos;hui. Le contenu Canadiana provient en grande partie de la s&eacute;rie de
          microfiches de l&apos;Institut canadien de microreproductions historiques (ICMH).
        </p>
      </div>
      <%= render partial: 'shared/canadiana_stack', locals: { count: 12, collection: :canadiana } %>
    </div>
  </section>
</div>

