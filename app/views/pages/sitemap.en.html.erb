<% content_for :page_title, "Sitemap - #{application_name}" %>

<div class="blacklight-pages-api_access">
  <section class="site-section api-site-section">
    <div class="container api-access-page api-access-page--modern">
      <header class="api-hero">
        <div class="api-hero__grid api-hero__grid--single">
          <div class="api-hero__copy">
            <h1 class="section-title">
              <span class="api-hero__eyebrow-text">Canadiana Collections And Infrastructure</span>
              <span class="api-hero__title-main">Sitemap</span>
            </h1>
            <p class="api-lede">
              Find the main pages across Canadiana Collections and Infrastructure in one place.
            </p>
          </div>
        </div>
      </header>

      <div class="api-content">
        <section class="api-card api-card--accent">
          <h2>Main pages</h2>
          <ul class="api-list api-list--bulleted">
            <li><a href="<%= root_path(lang: I18n.locale) %>">Home</a></li>
            <li><a href="<%= about_canadiana_path(lang: I18n.locale) %>">About the Canadiana Collection</a></li>
            <li><a href="<%= about_heritage_path(lang: I18n.locale) %>">About the Héritage Collection</a></li>
            <li><a href="<%= search_catalog_path(lang: I18n.locale) %>">Search the Canadiana Collection</a></li>
            <li><a href="<%= compare_collections_path(lang: I18n.locale) %>">Comparing the Collections</a></li>
            <li><a href="<%= navigating_collections_path(lang: I18n.locale) %>">Navigating the Collections</a></li>
            <li><a href="<%= api_access_path(lang: I18n.locale) %>">API Access</a></li>
            <li><a href="<%= what_is_iiif_path(lang: I18n.locale) %>">What is IIIF?</a></li>
            <li><a href="<%= citation_guide_path(lang: I18n.locale) %>">Citation Guide</a></li>
            <li><a href="<%= system_status_path(lang: I18n.locale) %>">System Status</a></li>
            <li><a href="<%= contact_us_page_path(lang: I18n.locale) %>">Contact Us</a></li>
            <li><a href="<%= terms_of_service_path(lang: I18n.locale) %>">Terms of Service</a></li>
          </ul>
        </section>
      </div>
    </div>
  </section>
</div>
