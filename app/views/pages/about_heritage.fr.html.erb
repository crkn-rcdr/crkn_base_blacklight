<div class="home-page">
  <section class="site-section home-intro home-intro--heritage-clean">
    <div class="canadiana-shell home-heritage-intro-grid">
      <div class="home-heritage-intro-media">
        <%= render partial: 'shared/canadiana_stack', locals: { count: 12, collection: :heritage } %>
      </div>
      <div class="home-heritage-intro-copy">
        <h1 class="section-title">Collection Héritage</h1>
        <p class="section-lede">
          La collection Héritage est un partenariat avec
          <a href="https://library-archives.canada.ca" target="_blank" rel="noopener">Bibliothèque et Archives Canada</a> (BAC)
          pour numériser et rendre accessibles les riches ressources de microfilms d’archives conservées par BAC.
          Avec plus de 37&nbsp;millions de pages de documents de source primaire, Héritage retrace le Canada et ses peuples
          des années 1600 aux années 1980.
        </p>
      </div>
      <div class="home-heritage-logo-card" aria-hidden="true">
        <img class="home-heritage-logo" src="<%= asset_path('lac.jpg') %>" alt="Logo de Bibliotheque et Archives Canada" loading="lazy">
      </div>
    </div>
  </section>
</div>

<section class="site-section">
  <div class="container">
    <h2 class="h4">Utiliser Héritage pour</h2>
    <ul>
      <li>La généalogie et l’histoire communautaire</li>
      <li>Les dossiers gouvernementaux et institutionnels</li>
      <li>La recherche en sources primaires</li>
    </ul>

  </div>
</section>
