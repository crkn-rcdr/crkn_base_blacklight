      <div class="home-slider" data-slider="explore">
        <button type="button" class="home-slider__nav home-slider__nav--prev" data-slider-prev aria-label="Cartes pr&eacute;c&eacute;dentes">
          <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="home-slider__viewport" data-slider-viewport>
          <div class="home-split-grid home-split-grid--slider" data-slider-track>
