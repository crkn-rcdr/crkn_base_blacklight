<div class="col-12 p-0 home-page">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="canadiana-shell">
      <div class="row g-4 align-items-start">
        <div class="col-lg-8">
          <p class="home-eyebrow">Canadiana + Collections et infrastructure</p>
          <h1 id="home-hero-title">D&eacute;couvrez des publications num&eacute;ris&eacute;es et des archives provenant de partout au Canada</h1>
          <p class="home-hero-copy">
            Canadiana donne acc&egrave;s &agrave; deux grandes collections&nbsp;: la collection Canadiana et la collection H&eacute;ritage.
            Chaque collection dispose de sa propre recherche ind&eacute;pendante et est accessible via les API Canadiana.
          </p>

          <div class="hero-primary-actions">
            <a class="btn hero-primary-btn" href="/#search-canadiana">
              Rechercher dans la collection Canadiana
            </a>
            <a class="btn hero-primary-btn" href="/#search-heritage">
              Rechercher dans la collection H&eacute;ritage
            </a>
          </div>

          <div class="hero-secondary-actions">
            <a class="hero-secondary-link" href="/about/monographs?lang=<%= I18n.locale %>">
              Comparer les deux collections
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
            <a class="hero-secondary-link" href="<%= what_is_iiif_path(lang: I18n.locale) %>">
              En savoir plus sur l&apos;acc&egrave;s API
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <aside class="hero-stat-card" aria-label="Statistiques de collection">
            <h2>68 millions +</h2>
            <p class="mb-2">Pages num&eacute;ris&eacute;es disponibles en ligne</p>
            <p class="mb-0">
              Contenu fourni par les
              <a href="/#members-section">biblioth&egrave;ques membres du RCDR</a>
              et
              <a href="https://library-archives.canada.ca" target="_blank" rel="noopener">Biblioth&egrave;que et Archives Canada</a>.
            </p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section home-intro home-intro--canadiana">
    <div class="canadiana-shell">
      <h2 class="section-title">Collection Canadiana</h2>
      <p class="section-lede">
        Environ 31&nbsp;millions de pages de publications montrent comment les connaissances, les histoires et l&apos;information
        ont &eacute;t&eacute; partag&eacute;es au fil du temps. Cette collection comprend des livres, journaux, magazines, documents
        gouvernementaux, cartes et plus encore, de 1500 &agrave; aujourd&apos;hui. Le contenu Canadiana provient en grande partie de
        la s&eacute;rie de microfiches de l&apos;Institut canadien de microreproductions historiques (ICMH).
      </p>
      <a class="home-inline-link home-inline-link--arrow" href="/about/monographs?lang=<%= I18n.locale %>">
        En savoir plus
        <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <section id="search-canadiana" class="home-collection-band home-collection-band--teal home-collection-band--canadiana">
    <div class="canadiana-shell">
      <div class="home-collection-band__panel">
        <div class="home-collection-band__copy">
          <p class="home-eyebrow">Rechercher dans la collection Canadiana</p>
          <h3>Des millions de pages de publications qui t&eacute;moignent des personnes, des &eacute;v&eacute;nements et des exp&eacute;riences qui ont fa&ccedil;onn&eacute; les territoires maintenant connus comme le Canada.</h3>

          <form class="band-search-form band-search-form--canadiana" action="/catalog" method="get">
            <input type="hidden" name="lang" value="<%= I18n.locale %>">
            <label class="visually-hidden" for="canadiana-band-field">Champ de recherche</label>
            <select id="canadiana-band-field" class="band-search-select" name="search_field">
              <option value="all_fields">Tous les champs</option>
              <option value="full_title_tsim">Titre</option>
              <option value="author_tsim">Cr&eacute;ateur</option>
              <option value="subject_tsim">Sujet</option>
              <option value="tx_gen">Texte int&eacute;gral</option>
            </select>
            <label class="visually-hidden" for="canadiana-band-q">Rechercher dans la collection Canadiana</label>
            <input id="canadiana-band-q" class="band-search-input js-typed-placeholder" type="search" name="q" placeholder="Rechercher..." data-typed-placeholder-phrases="Sessional Papers of the Dominon of Canada|The Toronto World|大漢公報 (Chinese Times)|The Dawn of Tomorrow|Anne of the Island">
            <button type="submit" class="btn btn-primary btn-sm">Chercher</button>
          </form>

          <a class="home-inline-link home-inline-link--history" href="/catalog?lang=<%= I18n.locale %>&q=&search_field=all_fields">Mes recherches r&eacute;centes</a>
        </div>
        <div class="home-collection-band__image">

          <iframe src="https://preview.exhibitionviewer.org/preview/slideshow?manifest=https://manifest-editor.digirati.services/api/iiif/p3/5d697a9dafc09660ad9f1f4fce3c7c12/1771509193491&minimal=true" class="exhibit" title="Apercu du diaporama de la collection Canadiana" width="440" height="560" loading="lazy"></iframe>

        </div>
      </div>
    </div>
  </section>

  <section class="site-section home-walkthrough canadiana-walkthrough py-0">
    <div class="canadiana-shell">
      <a href="<%= I18n.t('links.URL_DOWNLOAD_DOCS') %>" target="_blank" rel="noopener">
