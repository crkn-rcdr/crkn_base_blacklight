<div id="home-page-top" class="col-12 p-0 home-page">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="canadiana-shell">
      <div class="row g-4 align-items-start">
        <div class="col-lg-8">
          <p class="home-eyebrow">Les collections et l’infrastructure de Canadiana</p>
          <h1 id="home-hero-title">Découvrez des publications numérisées et des documents d'archives provenant de partout au Canada.</h1>
          <p class="home-hero-copy">
            Canadiana offre l'accès à deux collections majeures : la collection Canadiana et la collection Héritage.
            Chaque collection dispose de son propre moteur de recherche indépendant et est accessible via les API de Canadiana.
          </p>

          <div class="hero-primary-actions">
            <a class="btn hero-primary-btn" href="/#search-canadiana">
              Rechercher dans la collection Canadiana
            </a>
            <a class="btn hero-primary-btn" href="/#search-heritage">
              Rechercher dans la collection Héritage
            </a>
          </div>

          <div class="hero-secondary-actions">
            <a class="hero-secondary-link" href="<%= compare_collections_path(lang: I18n.locale) %>">
              Comparer les deux collections
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
            <a class="hero-secondary-link" href="<%= api_access_path(lang: I18n.locale) %>">
              En savoir plus sur l'accès aux API
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="hero-stat-card">
            <h2>Plus de 69 millions</h2>
            <p class="mb-2">de pages numérisées disponibles en ligne</p>
            <p class="mb-0">
              Contenu fourni par les
              <a href="/#members-section">bibliothèques membres du RCDR</a>
              et
              <a href="https://www.canada.ca/fr/bibliotheque-archives.html" target="_blank" rel="noopener">Bibliothèque et Archives Canada</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section home-intro home-intro--canadiana-clean">
    <div class="canadiana-shell">
      <div class="home-canadiana-intro-copy">
        <h2 class="section-title">Collection Canadiana</h2>
        <p class="section-lede">
          Environ 31,5 millions de pages de publications qui illustrent comment les connaissances, les récits et les informations ont été partagés au fil du temps. Cette collection comprend des livres, des journaux, des magazines, des documents gouvernementaux, des cartes et d'autres documents datant d'environ 1500 à nos jours. Le contenu de Canadiana provient en grande partie de la série de microfiches de l’Institut canadien de microreproductions historiques (ICMH).
        </p>
        <a class="home-inline-link home-inline-link--arrow" href="<%= about_canadiana_path(lang: I18n.locale) %>">
          En savoir plus
          <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <section id="search-canadiana" class="home-collection-band home-collection-band--canadiana-clean">
    <div class="canadiana-shell">
      <div class="home-collection-band__panel">
        <div class="home-collection-band__copy">
          <p class="home-eyebrow">Rechercher dans la collection Canadiana</p>
          <h3>Des millions de pages de publications reflétant les peuples, les événements et les expériences qui ont façonné les terres aujourd’hui connues sous le nom de Canada.</h3>

          <form class="band-search-form band-search-form--canadiana" action="/catalog" method="get">
            <input type="hidden" name="lang" value="<%= I18n.locale %>">
            <label class="visually-hidden" for="canadiana-band-field">Champ de recherche</label>
            <select id="canadiana-band-field" class="band-search-select" name="search_field">
