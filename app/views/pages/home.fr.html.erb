  <% featured_items = [
    { id: 'oon.00001_198410', ark: 'https://n2t.net/ark:/69429/m0z31ng4pk4n', title: 'Science Dimension', description: 'Explorez des documents du Nord et du patrimoine documentaire associe.' },
    { id: 'qmma.05919', ark: 'https://n2t.net/ark:/69429/m0736m04393j', title: '[Systeme topographique national, 1:50 000 : Canada : Heart\'s Content, Terre-Neuve]', description: 'Ressources topographiques et cartographiques de partout au Canada.' },
    { id: 'nswa.00001_192612', ark: 'https://n2t.net/ark:/69429/m2025000011pw36', title: 'Acadia athenaeum : The Acadia athenaeum', description: 'Publications universitaires et etudiantes issues des collections historiques.' },
    { id: 'oocihm.lac_reel_t1741', ark: 'https://n2t.net/ark:/69429/m07h1dj5927j', title: 'Herzberg Institute of Astrophysics', description: 'Publications scientifiques et documents de recherche astronomique.', start_page: 1734 },
    { id: 'oocihm.lac_reel_c13421', ark: 'https://n2t.net/ark:/69429/m0nv9959cv8t', title: 'Chinese immigration records: Sample Chinese immigration certificates : C-13421', description: 'Sources primaires preservees par des institutions partenaires.', start_page: 54 },
    { id: 'oocihm.lac_reel_c1845', ark: 'https://n2t.net/ark:/69429/m0x05x63bt10', title: 'Joseph Howe fonds : C-1845', description: 'Manuscrits d\'archives sur l\'histoire sociale et politique du Canada.', start_page: 9 }
  ] %>
  <% featured_page = params[:featured_page].to_i %>
  <% featured_page = 1 if featured_page < 1 %>
  <% featured_component = FeaturedItemsComponent.new(items: featured_items, page: featured_page, per_page: 8) %>
  <% show_featured_pagination = featured_component.show_pagination? %>
  <% if show_featured_pagination %>
    <% base_featured_params = params.to_unsafe_h.except('featured_page', :featured_page) %>
    <% prev_featured_params = base_featured_params.dup %>
    <% next_featured_params = base_featured_params.dup %>
    <% prev_featured_params[:featured_page] = featured_component.prev_page if featured_component.prev_page > 1 %>
    <% next_featured_params[:featured_page] = featured_component.next_page if featured_component.next_page > 1 %>
    <% prev_featured_params[:anchor] = 'featured-content' %>
    <% next_featured_params[:anchor] = 'featured-content' %>
    <% prev_featured_disabled = featured_component.page <= 1 %>
    <% next_featured_disabled = featured_component.page >= featured_component.total_pages %>
  <% end %>
  <section class="site-section home-featured" id="featured-content">
    <div class="canadiana-shell">
      <div class="home-featured-head">
        <h2 class="section-title">Contenu en vedette</h2>
        <% if show_featured_pagination %>
          <div class="home-featured-nav">
            <% if prev_featured_disabled %>
              <span class="home-slider__nav home-featured-nav__icon is-disabled" aria-hidden="true">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
              </span>
            <% else %>
              <a class="home-slider__nav home-featured-nav__icon" href="<%= url_for(prev_featured_params) %>" aria-label="Contenu en vedette précédent">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
              </a>
            <% end %>
            <% if next_featured_disabled %>
              <span class="home-slider__nav home-featured-nav__icon is-disabled" aria-hidden="true">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </span>
            <% else %>
              <a class="home-slider__nav home-featured-nav__icon" href="<%= url_for(next_featured_params) %>" aria-label="Contenu en vedette suivant">
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              </a>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= render featured_component %>
    </div>
  </section>

  <section class="site-section home-exhibition-preview" aria-labelledby="home-exhibition-preview-title">
    <div class="canadiana-shell">
      <div class="home-exhibition-preview__intro">
