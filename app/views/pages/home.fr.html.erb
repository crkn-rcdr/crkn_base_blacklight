          <iframe src="https://preview.exhibitionviewer.org/preview/slideshow?manifest=https://manifest-editor.digirati.services/api/iiif/p3/5d697a9dafc09660ad9f1f4fce3c7c12/1771509193491&minimal=true" class="exhibit" title="Apercu du diaporama de la collection Canadiana" width="440" height="560" loading="lazy" scrolling="no" aria-hidden="true" tabindex="-1"></iframe>

        </div-->
      </div>
    </div>
  </section>

