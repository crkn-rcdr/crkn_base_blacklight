              <option value="full_title_tsim">Titre</option>
              <option value="author_tsim">Créateur</option>
              <option value="subject_tsim">Sujet</option>
              <option value="tx_gen">Texte intégral</option>
            </select>
            <label class="visually-hidden" for="canadiana-band-q">Rechercher dans la collection Canadiana</label>
            <input id="canadiana-band-q" class="band-search-input js-typed-placeholder" type="search" name="q" placeholder="Rechercher..." data-typed-placeholder-phrases="Sessional Papers of the Dominon of Canada|The Toronto World|&#22823;&#28450;&#20844;&#22577; (Chinese Times)|The Dawn of Tomorrow|Anne of the Island">
            <button type="submit" class="btn btn-primary btn-sm">Rechercher</button>
          </form>

          <div class="home-collection-band__meta-row">
            <div class="home-walkthrough-inline canadiana-walkthrough">
              <a href="/">
                <i class="bi bi-play-circle home-walkthrough__icon" aria-hidden="true"></i>
                Vidéo d’instruction : Comment rechercher dans la collection Canadiana
              </a>
            </div>
            <a class="home-inline-link home-inline-link--history" href="/catalog?lang=<%= I18n.locale %>&q=&search_field=all_fields">Mes recherches récentes</a>
          </div>
        </div>
