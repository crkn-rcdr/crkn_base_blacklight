<div class="blacklight-pages-api_access">
  <section class="site-section api-site-section">
    <div class="container api-access-page api-access-page--modern">
      <header class="api-hero">
        <div class="api-hero__grid api-hero__grid--single">
          <div class="api-hero__copy">
            <h1 class="section-title">
              <span class="api-hero__eyebrow-text">Canadiana Collections And Infrastructure</span>
              <span class="api-hero__title-main">System Status</span>
            </h1>
            <p class="api-lede">
              Status updates for the Canadiana and Héritage websites, including service interruptions and system downtime.
            </p>
          </div>
        </div>
      </header>

      <div class="api-layout">
        <aside class="api-toc" aria-label="On this page">
          <h2 class="api-toc__title">On this page</h2>
          <a href="#status-updates">Status updates</a>
          <a href="#status-hours">Update hours</a>
          <a href="#status-current">Current status</a>
          <a href="#status-support">Support contact</a>
        </aside>

        <div class="api-content">
          <section id="status-updates" class="api-card">
            <h2>Status updates</h2>
            <p>
              This page provides status updates for the
              <a href="<%= I18n.t('links.URL_CANADIANA') %>" target="_blank" rel="noopener">Canadiana</a>
              and
              <a href="<%= I18n.t('links.URL_HERITAGE') %>" target="_blank" rel="noopener">Héritage</a>
              websites, including service interruptions and system downtime.
            </p>
          </section>

          <section id="status-hours" class="api-card">
            <h2>Update hours</h2>
            <p>
              This page is typically updated between 8:30 a.m. and 4:30 p.m. ET, Monday to Friday.
            </p>
          </section>

          <section id="status-current" class="api-card">
            <h2>Current status</h2>
            <h3>Canadiana</h3>
            <p>Canadiana is functioning normally.</p>
            <h3>Héritage</h3>
            <p>Héritage is functioning normally.</p>
          </section>

          <section id="status-support" class="api-card">
            <h2>Support contact</h2>
            <p>
              For best performance, use a high-speed internet connection when accessing Canadiana and Héritage.
              If you are experiencing access problems not listed on this page, contact
              <a href="mailto:info@crkn.ca">info@crkn.ca</a>
              and continue to monitor this page for additional information.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</div>
