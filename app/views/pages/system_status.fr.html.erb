<div class="blacklight-pages-api_access">
  <section class="site-section api-site-section">
    <div class="container api-access-page api-access-page--modern">
      <header class="api-hero">
        <div class="api-hero__grid api-hero__grid--single">
          <div class="api-hero__copy">
            <h1 class="section-title">
              <span class="api-hero__eyebrow-text">Collections et infrastructure Canadiana</span>
              <span class="api-hero__title-main">État du système</span>
            </h1>
            <p class="api-lede">
              Mises à jour de disponibilité pour les services Canadiana et Héritage.
            </p>
          </div>
        </div>
      </header>

      <div class="api-layout">
        <aside class="api-toc" aria-label="Sur cette page">
          <h2 class="api-toc__title">Sur cette page</h2>
          <a href="#fr-status-live">État en direct</a>
          <a href="#fr-status-services">Services suivis</a>
          <a href="#fr-status-incident">En cas de perturbation</a>
          <a href="#fr-status-contact">Contacter le soutien</a>
        </aside>

        <div class="api-content">
          <section id="fr-status-live" class="api-card">
            <h2>État en direct</h2>
            <p>
              Consultez la page d’état pour les incidents actifs, les dégradations et les interruptions planifiées.
            </p>
            <p>
              <a href="<%= I18n.t('links.URL_SYSTEM') %>" target="_blank" rel="noopener">Ouvrir la page d’état en direct</a>
            </p>
          </section>

          <section id="fr-status-services" class="api-card">
            <h2>Services suivis</h2>
            <ul class="api-list">
              <li>Recherche au catalogue et pages de notices</li>
              <li>Diffusion IIIF des manifestes et des images</li>
              <li>Accès API et intégrations associées</li>
            </ul>
          </section>

          <section id="fr-status-incident" class="api-card">
            <h2>En cas de perturbation</h2>
            <ul class="api-list">
              <li>Vérifiez d’abord la page d’état pour les incidents actifs</li>
              <li>Réessayez quelques minutes plus tard en cas de dégradation temporaire</li>
              <li>Si le problème persiste, contactez le soutien avec l’URL, l’heure et le message d’erreur</li>
            </ul>
          </section>

          <section id="fr-status-contact" class="api-card">
            <h2>Contacter le soutien</h2>
            <p>
              Si vous devez signaler un problème, utilisez la page
              <a href="<%= contact_us_page_path(lang: I18n.locale) %>">Nous joindre</a>
              pour transmettre les détails techniques.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</div>
