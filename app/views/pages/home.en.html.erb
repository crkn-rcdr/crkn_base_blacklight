  <section class="site-section home-intro home-intro--canadiana-clean">
    <div class="canadiana-shell">
      <div class="home-canadiana-intro-copy">
        <h2 class="section-title">Canadiana Collection</h2>
        <p class="section-lede">
          Approximately 31.5 million pages of publications that show how knowledge, stories, and information were shared over time. This collection includes books, newspapers, magazines, government documents, maps, and more from c. 1500 to the present day. Canadiana content is largely drawn from the Canadian Institute for Historic Micro-reproductions (CIHM) microfiche series.
        </p>
        <a class="home-inline-link home-inline-link--arrow" href="<%= about_canadiana_path(lang: I18n.locale) %>">
          Learn more
          <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

