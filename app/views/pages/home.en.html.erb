          <h1 id="home-hero-title">Discover digitized publications and archival records from across Canada</h1>
          <p class="home-hero-copy">
            Canadiana provides access to two major collections: the Canadiana Collection and the Héritage Collection. Each collection has its own independent search and can be accessed through the Canadiana APIs.
          </p>

          <div class="hero-primary-actions">
            <a class="btn hero-primary-btn" href="/#search-canadiana">
              Search the Canadiana Collection
            </a>
            <a class="btn hero-primary-btn" href="/#search-heritage">
              Search the Héritage Collection
            </a>
          </div>

          <div class="hero-secondary-actions">
            <a class="hero-secondary-link" href="<%= compare_collections_path(lang: I18n.locale) %>">
              Compare the two collections
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
            <a class="hero-secondary-link" href="<%= api_access_path(lang: I18n.locale) %>">
              Learn about API access
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="hero-stat-card">
            <h2>69 million+</h2>
            <p class="mb-2">digitized pages available online</p>
            <p class="mb-0">
              Content contributed by
              <a href="/#members-section">CRKN member libraries</a>
              and
              <a href="https://library-archives.canada.ca" target="_blank" rel="noopener">Library and Archives Canada</a>.
            </p>
          </div>
