              <div class="home-split-card__content">
                <div>
                  <h3 class="home-split-card__title">Newspapers and Magazines</h3>
                  <p class="home-split-card__text">Discover everyday life, local stories, and community news from towns and cities across Canada.</p>
                </div>
                <div class="home-split-card__actions">
                  <a href="/catalog?f%5Bcollection_tsim_str%5D%5B%5D=Serials+%7C+Publications+en+se%CC%81rie&q=&search_field=all_fields&lang=<%= I18n.locale %>" class="btn btn-sm home-split-card__cta">Browse</a>
                </div>
              </div>
