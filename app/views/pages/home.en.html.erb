            <label class="visually-hidden" for="heritage-band-field">Search field</label>
            <select id="heritage-band-field" class="band-search-select" name="search_field">
              <option value="all_fields">All fields</option>
              <option value="full_title_tsim">Title</option>
              <option value="author_tsim">Creator</option>
              <option value="subject_tsim">Subject</option>
              <option value="tx_gen">Full text</option>
            </select>
            <label class="visually-hidden" for="heritage-band-q">Search the Heritage Collection</label>
            <input id="heritage-band-q" class="band-search-input js-typed-placeholder" type="search" name="q" placeholder="Search..." data-typed-placeholder-phrases="Felt hats in|Genealogy|Military history|Land records|Indigenous affairs|Census records">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
          </form>

          <a class="home-inline-link home-inline-link--history" href="/search_history">My Recent Searches</a>
        </div>
        <div class="home-collection-band__image">
          
          <iframe src="https://preview.exhibitionviewer.org/preview/slideshow?manifest=https://manifest-editor.digirati.services/api/iiif/p3/5d697a9dafc09660ad9f1f4fce3c7c12/1771509193491&minimal=true" class="exhibit"></iframe>
     
        </div>
      </div>
    </div>
  </section>

  <section class="site-section home-walkthrough heritage-bg py-0">
    <div class="canadiana-shell">
      <a href="<%= I18n.t('links.URL_HERITAGE') %>" target="_blank" rel="noopener">
        <i class="bi bi-play-circle home-walkthrough__icon" aria-hidden="true"></i>
        Short walk-through: How to use the Héritage Collection search
      </a>
    </div>
  </section>

  <section class="site-section home-explore heritage-bg">
    <div class="canadiana-shell">
      <h3 class="section-title">Explore Archival Materials</h3>
      <div class="home-slider" data-slider="explore">
        <button type="button" class="home-slider__nav home-slider__nav--prev" data-slider-prev aria-label="Previous cards">
          <i class="bi bi-chevron-left" aria-hidden="true"></i>
        </button>
        <div class="home-slider__viewport" data-slider-viewport>
          <div class="home-split-grid home-split-grid--slider" data-slider-track>
            <article class="home-split-card home-split-card--green">
              <div class="home-split-card__content">
                <div>
                  <h3 class="home-split-card__title">Family and Community History</h3>
