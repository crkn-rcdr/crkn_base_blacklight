<div class="col-12 p-0 home-page">
  <section class="home-hero" aria-labelledby="home-hero-title">
    <div class="canadiana-shell">
      <div class="row g-4 align-items-start">
        <div class="col-lg-8">
          <p class="home-eyebrow">Canadiana collections and infrastructure</p>
          <h1 id="home-hero-title">Discover digitized publications and 
archival records from across Canada</h1>
          <p class="home-hero-copy">
            Canadiana provides access to two major collections: the Canadiana Collection and the Héritage Collection. Each collection has its own independent search and can be accessed through the Canadiana APIs.
          </p>

          <div class="hero-primary-actions">
            <a class="btn hero-primary-btn" href="/#search-canadiana">
              Search the Canadiana Collection
            </a>
            <a class="btn hero-primary-btn" href="/#search-heritage">
              Search the Héritage Collection
            </a>
          </div>

          <div class="hero-secondary-actions">
            <a class="hero-secondary-link" href="/about/monographs?lang=<%= I18n.locale %>">
              Compare the two collections
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
            <a class="hero-secondary-link" href="<%= what_is_iiif_path(lang: I18n.locale) %>">
              Learn about API access
              <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="col-lg-4">
          <aside class="hero-stat-card" aria-label="Collection statistics">
            <h2>68 million +</h2>
            <p class="mb-2">Digitized pages available online</p>
            <p class="mb-0">
              Content contributed by
              <a href="/#members-section">CRKN member libraries</a>
              and
              <a href="https://library-archives.canada.ca" target="_blank" rel="noopener">Library and Archives Canada</a>.
            </p>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="site-section home-intro home-intro--canadiana">
    <div class="canadiana-shell">
      <h2 class="section-title">Canadiana Collection</h2>
      <p class="section-lede">
        Approximately 31 million pages of publications that show how knowledge, stories, and information were shared over time. This collection includes books, newspapers, magazines, government documents, maps, and more from c. 1500 to the present day. Canadiana content is largely drawn from the Canadian Institute for Historic Micro-reproductions (CIHM) microfiche series.
      </p>
      <a class="home-inline-link home-inline-link--arrow" href="/about/monographs?lang=<%= I18n.locale %>">
        Learn more
        <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
      </a>
    </div>
  </section>

  <section id="search-canadiana" class="home-collection-band home-collection-band--teal home-collection-band--canadiana">
    <div class="canadiana-shell">
      <div class="home-collection-band__panel">
        <div class="home-collection-band__copy">
          <p class="home-eyebrow">Search the Canadiana Collection</p>
          <h3>Millions of pages of publications reflecting the peoples, events, and experiences that shaped the lands now known as Canada.</h3>

          <form class="band-search-form band-search-form--canadiana" action="/catalog" method="get">
            <input type="hidden" name="lang" value="<%= I18n.locale %>">
            <label class="visually-hidden" for="canadiana-band-field">Search field</label>
            <select id="canadiana-band-field" class="band-search-select" name="search_field">
              <option value="all_fields">All fields</option>
              <option value="full_title_tsim">Title</option>
              <option value="author_tsim">Creator</option>
              <option value="subject_tsim">Subject</option>
              <option value="tx_gen">Full text</option>
            </select>
            <label class="visually-hidden" for="canadiana-band-q">Search the Canadiana Collection</label>
            <input id="canadiana-band-q" class="band-search-input js-typed-placeholder" type="search" name="q" placeholder="Search..." data-typed-placeholder-phrases="Car|Maps|Newspapers|Government records|Magazines|Communities">
            <button type="submit" class="btn btn-primary btn-sm">Search</button>
          </form>

          <a class="home-inline-link home-inline-link--history" href="/search_history">My Recent Searches</a>
        </div>
        <div class="home-collection-band__image">
          
          <iframe src="https://preview.exhibitionviewer.org/preview/slideshow?manifest=https://manifest-editor.digirati.services/api/iiif/p3/5d697a9dafc09660ad9f1f4fce3c7c12/1771509193491&minimal=true" class="exhibit"></iframe>

        </div>
      </div>
    </div>
  </section>

  <section class="site-section home-walkthrough canadiana-walkthrough py-0">
    <div class="canadiana-shell">
      <a href="<%= I18n.t('links.URL_DOWNLOAD_DOCS') %>" target="_blank" rel="noopener">
        <i class="bi bi-play-circle home-walkthrough__icon" aria-hidden="true"></i>
        Short walk-through: How to use the Canadiana Collection search
      </a>
    </div>
  </section>

