          <h3 id="iiif-content-search">IIIF Content Search API</h3>
          <div class="api-table-wrap">
            <table class="api-table">
              <caption class="visually-hidden">IIIF Content Search endpoint</caption>
              <thead>
                <tr>
                  <th scope="col">Endpoint</th>
                  <th scope="col">Path</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Content Search endpoint (template)</th>
                  <td><code>GET /search/{repository_id}/{manifest_id}?q={term}</code></td>
                </tr>
                <tr>
                  <th scope="row">Content Search endpoint (example)</th>
                  <td><code>GET https://crkn-iiif-content-search.azurewebsites.net/search/69429/m0tt4fn16j1j?q=roi</code></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p>
            Full specification:
            <a href="https://iiif.io/api/search/2.0/">IIIF Content Search API 2.0</a>.
          </p>
          <h4>Response formats</h4>
          <div class="api-table-wrap">
            <table class="api-table">
              <caption class="visually-hidden">IIIF Content Search response formats</caption>
              <thead>
                <tr>
                  <th scope="col">Endpoint</th>
                  <th scope="col">Response format</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">Content Search endpoint</th>
                  <td>JSON-LD (IIIF Search API 2.0); top-level <code>type</code> is <code>AnnotationPage</code>, <code>items</code> contains hit annotations, and <code>next</code> is present when results are paginated.</td>
                </tr>
              </tbody>
            </table>
          </div>
          <h4>Response shape (IIIF Search API 2.0)</h4>
          <div class="api-table-wrap">
            <table class="api-table">
              <caption class="visually-hidden">IIIF Content Search response shape fields</caption>
              <thead>
                <tr>
                  <th scope="col">Field</th>
                  <th scope="col">Description</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row"><code>@context</code></th>
                  <td>JSON-LD context (for example <code>http://iiif.io/api/search/2/context.json</code>).</td>
                </tr>
                <tr>
                  <th scope="row"><code>id</code></th>
                  <td>Content Search endpoint URL for the manifest being searched.</td>
                </tr>
                <tr>
                  <th scope="row"><code>type</code></th>
                  <td><code>AnnotationPage</code>.</td>
                </tr>
                <tr>
                  <th scope="row"><code>items[]</code></th>
                  <td>Array of hit annotations; each item includes <code>motivation</code>, <code>body.value</code>, and <code>target</code> with an <code>#xywh=</code> selector.</td>
                </tr>
                <tr>
                  <th scope="row"><code>next</code></th>
                  <td>Optional pagination URL (for example <code>?start=100&amp;q=roi</code>).</td>
                </tr>
              </tbody>
            </table>
          </div>
