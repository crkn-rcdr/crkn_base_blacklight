    "summary": {"en": ["..."]},
    "items": [
        {
            "id": "{presentation_service}/canvas/69429/c2025000026xr85",
            "type": "Canvas",
            "width": 3936,
            "height": 3200,
            "label": {"en": ["Image 1"]},
            "items": [
                {
                    "type": "AnnotationPage",
                    "items": [
                        {
                            "type": "Annotation",
                            "motivation": "painting",
                            "target": "{presentation_service}/canvas/69429/c2025000026xr85",
                            "body": {
                                "id": "{image_service}/full/max/0/default.jpg",
                                "type": "Image",
                                "format": "image/jpeg",
                                "width": 3936,
                                "height": 3200,
                                "service": [
                                    {
                                        "id": "{image_service}",
                                        "type": "ImageService2",
                                        "profile": "level2"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ],
            "thumbnail": [{"id": "{image_service}/full/200,/0/default.jpg", "type": "Image", "format": "image/jpeg"}]
        }
	    ]
}</code></pre>
