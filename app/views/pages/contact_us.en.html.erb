<div class="blacklight-pages-api_access">
  <section class="site-section api-site-section">
    <div class="container api-access-page api-access-page--modern">
      <header class="api-hero">
        <div class="api-hero__grid api-hero__grid--single">
          <div class="api-hero__copy">
            <h1 class="section-title">
              <span class="api-hero__eyebrow-text">Canadiana Collections and Infrastructure</span>
              <span class="api-hero__title-main">Contact Us</span>
            </h1>
            <p class="api-lede">
              The Canadiana Collections and Infrastructure are managed by the Canadian Research Knowledge Network
              (CRKN). Please contact us for research questions and website troubleshooting.
            </p>
          </div>
        </div>
      </header>

      <div class="api-layout">
        <aside class="api-toc" aria-label="On this page">
          <h2 class="api-toc__title">On this page</h2>
          <a href="#contact-questions">Questions and Troubleshooting</a>
          <a href="#contact-digitization">Digitization Services</a>
          <a href="#contact-staff">CRKN Staff</a>
        </aside>

        <div class="api-content">
          <section id="contact-questions" class="api-card">
            <h2>Questions and Troubleshooting</h2>
            <p>
              Contact <a href="mailto:info@crkn.ca">info@crkn.ca</a> or
              <a href="tel:+16139077023">613-907-7023</a> for Canadiana research questions and website troubleshooting.
            </p>
            <p>
              Visit the <a href="<%= system_status_path(lang: I18n.locale) %>">System Status</a> page for any service
              interruptions or system downtime.
            </p>
          </section>

          <section id="contact-digitization" class="api-card">
            <h2>Digitization Services</h2>
            <p>
              CRKN partners with universities, libraries, and archives to digitize and preserve Canadian documentary
              heritage, expanding the Canadiana Collection for researchers, educators, and the public. Contact
              <a href="mailto:digitization@crkn.ca">digitization@crkn.ca</a> or
              <a href="tel:+16139077028">613-907-7028</a> for questions about CRKN's digitization services.
            </p>
          </section>

          <section id="contact-staff" class="api-card">
            <h2>CRKN Staff</h2>
            <p>
              Visit the <a href="https://www.crkn-rcdr.ca/en/staff" target="_blank" rel="noopener">CRKN Staff</a>
              page to contact a CRKN staff member directly.
            </p>
          </section>
        </div>
      </div>
    </div>
  </section>
</div>
