<% is_fr = I18n.locale.to_s.start_with?('fr') %>
<% is_heritage = (defined?(CatalogController) && CatalogController.respond_to?(:heritage?) && CatalogController.heritage?(self)) ||
                 t('blacklight.application_name').to_s.downcase.include?('héritage') ||
                 t('blacklight.application_name').to_s.downcase.include?('heritage') ||
                 ENV['SOLR_URL'].to_s.include?('heritage') ||
                 (respond_to?(:request) && request&.host.to_s.include?('heritage')) %>
<% portal_label = is_heritage ? 'Héritage' : 'Canadiana' %>
<aside class="feedback-sticky-banner" role="complementary" aria-label="<%= is_fr ? "Sondage de rétroaction #{portal_label} 2.0" : "#{portal_label} 2.0 feedback survey" %>" data-controller="feedback-banner">
  <div class="feedback-sticky-banner__inner">
    <div class="feedback-sticky-banner__text">
      <% if is_fr %>
        Merci d'avoir visité la plateforme <%= portal_label %> en version bêta ! Nous serions ravis de connaître votre avis. Veuillez nous <a href="https://form.simplesurvey.com/f/r/laFfRoM4?lang=FR" target="_blank" rel="noopener" class="feedback-sticky-banner__link">faire part de vos commentaires</a> sur la nouvelle interface. <a href="https://bit.ly/4yTyl8g" target="_blank" rel="noopener" class="feedback-sticky-banner__link">En savoir plus</a> sur ces changements.
      <% else %>
        Thank you for visiting the <%= portal_label %> beta platform! We would love to know what you think. Please <a href="https://form.simplesurvey.com/f/r/laFfRoM4" target="_blank" rel="noopener" class="feedback-sticky-banner__link">share your feedback</a> on the new interface and <a href="https://bit.ly/3WbBdPb" target="_blank" rel="noopener" class="feedback-sticky-banner__link">learn more about these changes</a>.
      <% end %>
    </div>
    <button type="button"
            class="feedback-sticky-banner__close btn-close btn-close-white"
            aria-label="<%= is_fr ? 'Fermer le bandeau' : 'Close banner' %>"
            data-action="feedback-banner#close">
    </button>
  </div>
</aside>
