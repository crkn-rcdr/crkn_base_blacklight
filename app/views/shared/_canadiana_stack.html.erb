<% slide_count = local_assigns.fetch(:count, 12) %>
<% stack_collection = local_assigns.fetch(:collection, :canadiana) %>
<% explore_text = I18n.locale.to_s.start_with?('fr') ? 'Explorer' : 'Explore' %>
<% canadiana_slides = canadiana_stack_cards(slide_count, collection: stack_collection).map { |card| card.merge(image_url: asset_path(card[:image])) } %>
<% initial_slide = canadiana_slides.first %>
<% initial_button_text = initial_slide[:label].presence || explore_text %>
<% initial_aria_label = initial_slide[:label].present? ? "#{explore_text}: #{initial_slide[:label]}" : explore_text %>

<div class="home-canadiana-feature"
     data-controller="slideshow"
     data-slideshow-explore-label-value="<%= explore_text %>"
     data-action="mouseenter->slideshow#stop mouseleave->slideshow#start focusin->slideshow#stop focusout->slideshow#start"
     data-canadiana-feature
     data-explore-label="<%= explore_text %>">
  <script type="application/json" data-canadiana-feature-data data-slideshow-target="data"><%= raw(json_escape(canadiana_slides.to_json)) %></script>
  <div class="home-canadiana-feature__viewport">
    <span
      class="home-canadiana-feature__slide is-active"
      data-canadiana-feature-slide="primary"
      data-slideshow-target="primarySlide"
      style="background-image: url('<%= initial_slide[:image_url] %>');"></span>
    <span class="home-canadiana-feature__slide"
          data-canadiana-feature-slide="secondary"
          data-slideshow-target="secondarySlide"
          aria-hidden="true"></span>
    <a
      class="home-canadiana-feature__explore-btn"
      data-canadiana-feature-link
      data-slideshow-target="featureLink"
      href="<%= initial_slide[:url] %>"
      target="_blank"
      rel="noopener"
      aria-label="<%= initial_aria_label %>"
      title="<%= initial_button_text %>">
      <span data-canadiana-feature-link-text data-slideshow-target="featureLinkText"><%= initial_button_text %></span>
      <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
    </a>
  </div>
</div>
