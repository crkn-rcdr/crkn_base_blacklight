<% is_fr = I18n.locale.to_s.start_with?('fr') %>
<% search_field_options = if is_fr
  [
    ['Tous', 'all_fields'],
    ['Titre', 'full_title_tsim'],
    ['Createur', 'author_tsim'],
    ['Sujet', 'subject_tsim'],
    ['Texte integral', 'tx_gen']
  ]
else
  [
    ['All fields', 'all_fields'],
    ['Title', 'full_title_tsim'],
    ['Creator', 'author_tsim'],
    ['Subject', 'subject_tsim'],
    ['Full text', 'tx_gen']
  ]
end %>

<section class="catalog-search-hero" aria-labelledby="catalog-search-hero-title">
  <div class="canadiana-shell">
    <div class="catalog-search-hero__layout">
      <h1 id="catalog-search-hero-title" class="catalog-search-hero__title">
        <%= is_fr ? 'Recherche dans la collection Canadiana' : 'Canadiana Collection Search' %>
      </h1>

      <div class="catalog-search-hero__search" role="navigation" aria-label="<%= is_fr ? 'Recherche' : 'Search' %>">
        <form class="catalog-search-hero__search-form" action="<%= url_for(controller: 'catalog', action: 'index', only_path: true, lang: I18n.locale) %>" accept-charset="UTF-8" method="get">
          <label class="sr-only visually-hidden" for="catalog_search_field"><%= is_fr ? 'Rechercher dans' : 'Search in' %></label>
          <%= select_tag :search_field,
                options_for_select(search_field_options, params[:search_field].presence || 'all_fields'),
                id: 'catalog_search_field',
                title: (is_fr ? 'Options de recherche ciblees' : 'Targeted search options'),
                class: 'catalog-search-hero__field' %>

          <label class="sr-only visually-hidden" for="catalog_search_q"><%= is_fr ? 'rechercher' : 'search for' %></label>
          <input
            value="<%= params[:q].to_s %>"
            placeholder="<%= is_fr ? 'Effectuer une recherche dans la collection Canadiana...' : 'Search the Canadiana collection...' %>"
            class="catalog-search-hero__input"
            aria-label="<%= is_fr ? 'rechercher' : 'search for' %>"
            type="search"
            name="q"
            id="catalog_search_q">

          <button class="catalog-search-hero__submit" type="submit" id="catalog-search-submit">
            <span><%= is_fr ? 'Rechercher' : 'Search' %></span>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<div class="catalog-search-hero__applied-shell">
  <div class="canadiana-shell">
    <div class="catalog-search-hero__applied" data-catalog-applied-params-target></div>
  </div>
</div>
