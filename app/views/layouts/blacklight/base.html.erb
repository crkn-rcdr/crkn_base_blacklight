<!DOCTYPE html>
<% html_attrs = html_tag_attributes.merge(lang: I18n.locale.to_s) %>
<%= content_tag :html, class: 'no-js', **html_attrs do %>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title><%= render_page_title %></title>
    <script>
      document.querySelector('html').classList.remove('no-js');
    </script>
    <%= opensearch_description_tag application_name, opensearch_catalog_url(format: 'xml') %>
    <%= favicon_link_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap">
    </noscript>
    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload"  %>

    <% if defined? Importmap %>
      <%= javascript_importmap_tags %>
    <% else %>
      <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <% end %>

    <%= csrf_meta_tags %>
    <%
      is_fr = I18n.locale.to_s.start_with?('fr')
      is_heritage = t('blacklight.application_name').to_s.downcase.include?('héritage') ||
                    t('blacklight.application_name').to_s.downcase.include?('heritage') ||
                    ENV['SOLR_URL'].to_s.include?('heritage') ||
                    ENV['DOWNLOAD_API_ENDPOINT'].to_s.include?('heritage') ||
                    ENV['BLACKLIGHT_HOST_ADDR'].to_s.include?('heritage')
      default_meta_desc = if is_heritage
        is_fr ? "La collection Héritage offre un accès libre à plus de 37,8 millions de pages de documents d'archives canadiennes et de microfilms de Bibliothèque et Archives Canada." : "The Héritage Collection provides free access to over 37.8 million pages of primary-source Canadian archival documents and microfilm from Library and Archives Canada."
      else
        is_fr ? "Canadiana offre un accès libre à plus de 69 millions de pages de documents historiques et de publications canadiennes numérisées." : "Canadiana provides open access to more than 69 million pages of digitized Canadian documentary heritage and historical publications."
      end
    %>
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : default_meta_desc %>">
    <meta name="iiif-manifest-base" content="<%= Rails.configuration.x.iiif_manifest_base %>">
    <meta name="iiif-content-search-base" content="<%= Rails.configuration.x.iiif_content_search_base %>">
    <meta name="iiif-image-base" content="<%= Rails.configuration.x.iiif_image_base %>">
    <%= content_for(:head) %>

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>

    <script src="/assets/openseadragon.min.js" defer></script>
  </head>
  <body class="<%= render_body_class %>">
    <%= render blacklight_config.skip_link_component.new do %>
      <%= content_for(:skip_links) %>
    <% end %>

    <%= render blacklight_config.header_component.new(blacklight_config: blacklight_config) %>

    <% is_home_page = controller_name == 'pages' && action_name == 'home' %>
    <% main_tag = :main %>
    <% main_container_opts = {
      id: "main-container",
      class: (is_home_page ? "canadiana-main" : container_classes),
      aria: { label: t('blacklight.main.aria.main_container') }
    } %>
    <%= content_tag main_tag, **main_container_opts do %>
      <% if controller_name == 'catalog' && action_name == 'index' %>
        <%= render 'shared/catalog_search_header' %>
        <div class="catalog-search-hero__applied-shell">
          <div class="canadiana-shell">
            <div class="catalog-search-hero__applied">
              <%= content_for(:container_header) %>
            </div>
          </div>
        </div>
      <% else %>
        <%= content_for(:container_header) %>
      <% end %>

      <section role="region" aria-label="<%= t('blacklight.main.aria.flash_messages', default: 'Notifications') %>">
        <%= render partial: 'shared/flash_msg', layout: 'shared/flash_messages' %>
      </section>

      <div class="row base-first-row">
        <%= content_for?(:content) ? yield(:content) : yield %>
      </div>
    <% end %>

    <%= render partial: 'shared/feedback_banner' %>
    <%= render partial: 'shared/footer' %>
    <%= render partial: 'shared/modal' %>
  </body>
<% end %>
