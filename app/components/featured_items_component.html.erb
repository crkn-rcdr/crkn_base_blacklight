<div class="home-featured-grid home-featured-grid--records" id="featured-items-list">
  <% if records.present? %>
    <% records.each do |record| %>
      <article class="featured-item featured-item--record">
        <div
          class="card-img-top featured-item__viewer"
          id="<%= viewer_id_for(record) %>"
          data-ark-id="<%= ark_identifier_for(record) %>"></div>
        <div class="featured-item__meta">
          <h3>
            <a href="<%= record_link(record) %>"><%= title_for(record) %></a>
          </h3>
          <% description = description_for(record) %>
          <% if description.present? %>
            <p><%= description %></p>
          <% end %>
        </div>
      </article>
    <% end %>
  <% else %>
    <p><%= t('blacklight.search.zero_results.title', default: 'No featured items found') %></p>
  <% end %>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const hasOpenSeadragon = typeof OpenSeadragon !== "undefined";
  const grid = document.getElementById('featured-items-list');
  if (!grid) return;

  const manifestCanvases = (manifest) => {
    if (Array.isArray(manifest?.items) && manifest.items.length) return manifest.items;
    const v2 = manifest?.sequences?.[0]?.canvases;
    return Array.isArray(v2) ? v2 : [];
  };

  const canvasSize = (canvas) => {
    const directWidth = Number(canvas?.width || canvas?.['@width']);
    const directHeight = Number(canvas?.height || canvas?.['@height']);
    if (directWidth > 0 && directHeight > 0) return { width: directWidth, height: directHeight };

    const body = canvas?.items?.[0]?.items?.[0]?.body || canvas?.images?.[0]?.resource;
    const bodyWidth = Number(body?.width || body?.['@width']);
    const bodyHeight = Number(body?.height || body?.['@height']);
    if (bodyWidth > 0 && bodyHeight > 0) return { width: bodyWidth, height: bodyHeight };

    return null;
  };

  const getGridColumns = () => {
    const columns = getComputedStyle(grid).gridTemplateColumns.split(' ').filter(Boolean).length;
    if (columns > 0) return columns;
    if (window.innerWidth <= 560) return 2;
    if (window.innerWidth <= 768) return 4;
    if (window.innerWidth <= 1100) return 8;
    if (window.innerWidth <= 1500) return 10;
    return 12;
  };

  const parseRatio = (viewer) => {
    const attrRatio = Number(viewer?.dataset?.ratio || 0);
    if (attrRatio > 0) return attrRatio;

    const aspect = String(viewer?.style?.aspectRatio || '');
    if (aspect.includes('/')) {
      const [wRaw, hRaw] = aspect.split('/');
      const w = Number(String(wRaw).trim());
      const h = Number(String(hRaw).trim());
      if (w > 0 && h > 0) return w / h;
    }

    return 1;
  };

  const templateForColumns = (columns) => {
    if (columns >= 12) return [6, 3, 3, 3, 6, 3, 3, 3];
    if (columns >= 10) return [5, 3, 2, 3, 5, 2, 3, 2];
    if (columns >= 8) return [4, 2, 2, 2, 4, 2, 2, 2];
    if (columns >= 4) return [4, 2, 2, 2, 4, 2];
    return [2];
  };

  const clamp = (value, min, max) => Math.max(min, Math.min(max, value));

  const tuneColSpan = (baseSpan, ratio, columns) => {
    let span = baseSpan;
    if (ratio >= 1.55 && span <= columns - 2) span += 1;
    if (ratio <= 0.78 && span >= 3) span -= 1;
    if (columns >= 8 && ratio >= 2 && span <= columns - 1) span += 1;
    return clamp(span, 1, columns);
  };

  const rowMetrics = (columns) => {
    if (columns >= 12) return { unit: 9, min: 20, max: 56 };
    if (columns >= 10) return { unit: 8.4, min: 18, max: 52 };
    if (columns >= 8) return { unit: 8, min: 16, max: 48 };
    if (columns >= 4) return { unit: 7.2, min: 14, max: 40 };
    return { unit: 6.4, min: 12, max: 32 };
  };

  const layoutFeaturedMasonry = () => {
    const cards = Array.from(grid.querySelectorAll('.featured-item--record'));
    if (!cards.length) return;

    const columns = getGridColumns();
    const template = templateForColumns(columns);
    const metrics = rowMetrics(columns);

    cards.forEach((card, index) => {
      const viewer = card.querySelector('.featured-item__viewer');
      const ratio = parseRatio(viewer);
      const baseSpan = template[index % template.length];
      const colSpan = tuneColSpan(baseSpan, ratio, columns);
      const rawRows = Math.round((colSpan / Math.max(ratio, 0.45)) * metrics.unit);
      const rowSpan = clamp(rawRows, metrics.min, metrics.max);

      card.style.setProperty('--col-span', String(colSpan));
      card.style.setProperty('--row-span', String(rowSpan));
    });
  };

  let resizeTimer = null;
  const scheduleLayout = () => {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(layoutFeaturedMasonry, 90);
  };

  layoutFeaturedMasonry();

  document.querySelectorAll('.featured-item__viewer[data-ark-id]').forEach((container) => {
    const arkId = (container.dataset.arkId || '').trim();
    if (!arkId || container.dataset.osdReady === '1') return;
    container.dataset.osdReady = '1';

    (async function () {
      const manifestUrl = `https://crkn-iiif-api.azurewebsites.net/manifest/${arkId}`;
      try {
        const response = await fetch(manifestUrl);
        const manifest = await response.json();
        const canvases = manifestCanvases(manifest);
        const firstCanvas = canvases[0];
        const size = canvasSize(firstCanvas);
        if (size) {
          const ratio = size.width / size.height;
          container.dataset.ratio = String(ratio);
          container.style.aspectRatio = `${size.width} / ${size.height}`;
        }

        const tileSources = canvases.map((canvas) => {
          const canvasId = String(canvas.id || canvas['@id'] || '');
          const parts = canvasId.split('/');
          const lastTwoParts = parts.slice(-2).join('/');
          return `https://image-tor.canadiana.ca/iiif/2/${encodeURIComponent(lastTwoParts)}/info.json`;
        }).filter(Boolean);

        if (!tileSources.length || !hasOpenSeadragon) {
          scheduleLayout();
          return;
        }

        OpenSeadragon({
          element: container,
          prefixUrl: "/assets/",
          sequenceMode: true,
          tileSources: tileSources,
          immediateRender: true,
          showReferenceStrip: false,
          showHomeControl: false,
          showZoomControl: false,
          showFullPageControl: false,
          defaultZoomLevel: 1.1
        });
        scheduleLayout();
      } catch (error) {
        console.error("Failed to load manifest or initialize OpenSeadragon for", container.id, error);
        scheduleLayout();
      }
    })();
  });

  window.addEventListener('resize', scheduleLayout, { passive: true });
});
</script>
