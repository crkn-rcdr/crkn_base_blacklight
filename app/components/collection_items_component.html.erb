<% activate_zoom_label = I18n.locale.to_s.start_with?('fr') ? 'Cliquer pour activer le zoom' : 'Click to activate zoom' %>
<div class="row align-items-start" id="collection-items-list">
  <% if @collection_items.present? %>
    <% @collection_items.each do |collection_item| %>
      <% if collection_item['is_issue']&.first == "Yes" %>
        <% viewer_id = "osd-#{collection_item['id'].to_s.gsub(/[^a-zA-Z0-9_-]/, '-')}" %>
        <% ark_value = Array(collection_item['ark']).first.to_s.strip %>
        <% ark_id = ark_value.sub('https://n2t.net/ark:/', '') %>
        <div class="card collection-item-card">
        <div
          class="card-img-top collection-item__viewer collection-item__viewer-frame"
          id="<%= viewer_id %>"
          data-ark-id="<%= ark_id %>"
          >
          <button type="button" class="collection-item__activate" aria-pressed="false"><%= activate_zoom_label %></button>
        </div>
          <div class="card-body">
            <% if collection_item['subtitle_tsim'] %>
              <h3 class="card-title h5">
                <a class="" href="/catalogue/<%= collection_item['id'] %>">
                  <%= collection_item['subtitle_tsim'][0] %>
                </a>
              </h3>
            <% end %>

            <% if collection_item['pub_date_si'] %>
              <p class="card-text"><%= collection_item['pub_date_si'][0] %></p>
            <% end %>
            <% if collection_item['collection_tsim'] %>
                <p class="card-text"><%= collection_item['collection_tsim'].last %></p>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p><%= t('labels.L_NO_ISSUES_MSG') %></p>
  <% end %>
</div>

<% max_visible = 12 %>
<% start_page = [@page - 2, 1].max %>
<% end_page = [start_page + max_visible - 1, @total_pages].min %>
<% start_page = [end_page - max_visible + 1, 1].max %>

<div class="row align-items-start">
  <nav aria-label="Page navigation">
    <ul class="pagination justify-content-center">
      <% if @page > 1 %>
        <li class="page-item">
          <%= link_to 'First', url_for(params.to_unsafe_h.merge(page: 1)), class: 'page-link' %>
        </li>
        <li class="page-item">
          <%= link_to 'Previous', url_for(params.to_unsafe_h.merge(page: @page - 1)), class: 'page-link' %>
        </li>
      <% else %>
        <li class="page-item disabled"><span class="page-link">First</span></li>
        <li class="page-item disabled"><span class="page-link">Previous</span></li>
      <% end %>

      <% if start_page > 1 %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% end %>

      <% (start_page..end_page).each do |p| %>
        <li class="page-item <%= 'active' if p == @page %>">
          <%= link_to p, url_for(params.to_unsafe_h.merge(page: p)), class: 'page-link' %>
        </li>
      <% end %>

      <% if end_page < @total_pages %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% end %>

      <% if @page < @total_pages %>
        <li class="page-item">
          <%= link_to 'Next', url_for(params.to_unsafe_h.merge(page: @page + 1)), class: 'page-link' %>
        </li>
        <li class="page-item">
          <%= link_to 'Last', url_for(params.to_unsafe_h.merge(page: @total_pages)), class: 'page-link' %>
        </li>
      <% else %>
        <li class="page-item disabled"><span class="page-link">Next</span></li>
        <li class="page-item disabled"><span class="page-link">Last</span></li>
      <% end %>
    </ul>
  </nav>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/openseadragon/4.1.0/openseadragon.min.js"></script>

<script>
function initializeCollectionItemViewers() {
  const hasOpenSeadragon = typeof OpenSeadragon !== "undefined";
  const list = document.getElementById("collection-items-list");
  if (!list || !hasOpenSeadragon) return;
  if (list.dataset.collectionItemsInitialized === "1") return;
  list.dataset.collectionItemsInitialized = "1";

  let activeViewerState = null;

  const manifestCanvases = (manifest) => {
    if (Array.isArray(manifest?.items) && manifest.items.length) return manifest.items;
    const v2 = manifest?.sequences?.[0]?.canvases;
    return Array.isArray(v2) ? v2 : [];
  };

  const deactivateViewer = (state) => {
    if (!state) return;
    const { viewer, container, overlay } = state;
    try {
      viewer.setMouseNavEnabled(false);
      if (viewer.gestureSettingsMouse) {
        viewer.gestureSettingsMouse.scrollToZoom = false;
      }
    } catch (_error) {}
    container.classList.remove("is-active");
    container.removeAttribute("data-lenis-prevent");
    const card = container.closest(".collection-item-card");
    if (card) {
      card.classList.remove("is-active");
      card.removeAttribute("data-lenis-prevent");
    }
    if (overlay) {
      overlay.hidden = false;
      overlay.setAttribute("aria-pressed", "false");
    }
  };

  const activateViewer = (viewer, container, overlay) => {
    if (activeViewerState && activeViewerState.viewer !== viewer) {
      deactivateViewer(activeViewerState);
    }
    try {
      viewer.setMouseNavEnabled(true);
      if (viewer.gestureSettingsMouse) {
        viewer.gestureSettingsMouse.scrollToZoom = true;
      }
    } catch (_error) {}
    container.classList.add("is-active");
    container.setAttribute("data-lenis-prevent", "true");
    const card = container.closest(".collection-item-card");
    if (card) {
      card.classList.add("is-active");
      card.setAttribute("data-lenis-prevent", "true");
    }
    if (overlay) {
      overlay.hidden = true;
      overlay.setAttribute("aria-pressed", "true");
    }
    activeViewerState = { viewer, container, overlay };
  };

  document.addEventListener("pointerdown", (event) => {
    if (!activeViewerState) return;
    if (activeViewerState.container.contains(event.target)) return;
    deactivateViewer(activeViewerState);
    activeViewerState = null;
  }, true);

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !activeViewerState) return;
    const overlay = activeViewerState.overlay;
    deactivateViewer(activeViewerState);
    activeViewerState = null;
    if (overlay) overlay.focus();
  });

  list.querySelectorAll(".collection-item__viewer[data-ark-id]").forEach((container) => {
    const arkId = (container.dataset.arkId || "").trim();
    if (!arkId || container.dataset.osdReady === "1") return;
    container.dataset.osdReady = "1";

    const overlay = container.querySelector(".collection-item__activate");

    (async function () {
      const manifestBase = document.querySelector('meta[name="iiif-manifest-base"]')?.getAttribute('content')?.replace(/\/+$/, '') || 'https://www-iiif-pres.canadiana.ca/manifest';
      const imageBase = document.querySelector('meta[name="iiif-image-base"]')?.getAttribute('content')?.replace(/\/+$/, '') || 'https://image-tor.canadiana.ca/iiif/2';
      const manifestUrl = `${manifestBase}/${arkId}`;
      try {
        const response = await fetch(manifestUrl);
        const manifest = await response.json();
        const canvases = manifestCanvases(manifest);
        const tileSources = canvases.map((canvas) => {
          const serviceId = canvas?.items?.[0]?.items?.[0]?.body?.service?.[0]?.['@id'] ||
                            canvas?.items?.[0]?.items?.[0]?.body?.service?.[0]?.id ||
                            canvas?.images?.[0]?.resource?.service?.['@id'] ||
                            canvas?.images?.[0]?.resource?.service?.id;
          if (serviceId) {
            return `${serviceId.replace(/\/+$/, '')}/info.json`;
          }
          const canvasId = String(canvas.id || canvas["@id"] || "");
          const parts = canvasId.split("/");
          const lastTwoParts = parts.slice(-2).join("/");
          return `${imageBase}/${encodeURIComponent(lastTwoParts)}/info.json`;
        }).filter(Boolean);

        if (!tileSources.length) {
          if (overlay) overlay.hidden = true;
          return;
        }

        const viewer = OpenSeadragon({
          element: container,
          prefixUrl: "/assets/",
          sequenceMode: true,
          tileSources: tileSources,
          immediateRender: true,
          showReferenceStrip: false,
          showHomeControl: false,
          showZoomControl: false,
          showFullPageControl: false,
          defaultZoomLevel: 1.1,
          gestureSettingsMouse: {
            scrollToZoom: false
          }
        });

        if (!viewer) return;

        viewer.addHandler("canvas-scroll", (event) => {
          if (!container.classList.contains("is-active")) return;
          if (event.originalEvent) {
            if (typeof event.originalEvent.stopPropagation === "function") {
              event.originalEvent.stopPropagation();
            }
            if (typeof event.originalEvent.preventDefault === "function") {
              event.originalEvent.preventDefault();
            }
          }
          event.preventDefault = true;
        });

        container.addEventListener("wheel", (event) => {
          if (container.classList.contains("is-active")) {
            event.stopPropagation();
            event.preventDefault();
          }
        }, { passive: false });

        viewer.setMouseNavEnabled(false);
        container.classList.remove("is-active");
        container.removeAttribute("data-lenis-prevent");

        if (overlay) {
          overlay.hidden = false;
          overlay.setAttribute("aria-pressed", "false");
          overlay.addEventListener("click", (event) => {
            event.preventDefault();
            event.stopPropagation();
            activateViewer(viewer, container, overlay);
          });
        }

        container.addEventListener("pointerdown", (event) => {
          if (container.classList.contains("is-active")) return;
          if (overlay && overlay.contains(event.target)) return;
          activateViewer(viewer, container, overlay);
        });
      } catch (error) {
        console.error("Failed to load manifest or initialize OpenSeadragon for", container.id, error);
        if (overlay) overlay.hidden = true;
      }
    })();
  });
}

document.addEventListener("DOMContentLoaded", initializeCollectionItemViewers);
document.addEventListener("turbo:load", initializeCollectionItemViewers);

if (document.readyState !== "loading") {
  initializeCollectionItemViewers();
}
</script>
