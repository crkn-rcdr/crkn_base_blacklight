<%= content_tag @component,
  id: @id,
  data: {
    'document-id': @document.id.to_s.parameterize,
    'document-counter': @counter,
    'is-issue': @document._source['is_issue']&.first == 'Yes',
    'parent-serial-id': @document._source['serial_key']&.first,
    'serial-title': @document._source['serial_title']&.first
  },
  itemscope: true,
  itemtype: @document.itemtype,
  class: classes.flatten.join(' ') do %>

  <%= header %>

  <% if body.present? %>
    <%= body %>
  <% else %>
    <div class="document-main-section">

      <% if @component.to_s == 'div' %>
        <% breadcrumb_paths = helpers.collection_breadcrumb_paths(@document) %>
        <%
          is_fr = I18n.locale.to_s.start_with?('fr')
          is_heritage = (defined?(helpers.portal_heritage?) && helpers.portal_heritage?) ||
                        ENV['SOLR_URL'].to_s.include?('heritage') ||
                        ENV['DOWNLOAD_API_ENDPOINT'].to_s.include?('heritage') ||
                        ENV['BLACKLIGHT_HOST_ADDR'].to_s.include?('heritage')
          root_breadcrumb_label = if is_heritage
            t('blacklight.breadcrumbs.heritage', default: (is_fr ? 'Collection Héritage - Résultats de recherche' : 'Héritage Collection - Search Results'))
          else
            t('blacklight.breadcrumbs.canadiana', default: (is_fr ? 'Collection Canadiana - Résultats de recherche' : 'Canadiana Collection - Search Results'))
          end
        %>
        <% root_breadcrumb_url = helpers.back_to_search_url %>
        <%
          has_serial = @document._source['is_issue']&.first == "Yes" && @document._source['serial_title']&.first.present?
          serial_title = @document._source['serial_title']&.first.to_s.strip
          serial_key = @document._source['serial_key']&.first
          lang_param = params[:lang].presence || (I18n.locale.to_s.start_with?('fr') ? 'fr' : 'en')
          parent_url = serial_key.present? ? "/catalogue/#{ERB::Util.url_encode(serial_key)}?lang=#{ERB::Util.url_encode(lang_param)}" : nil
        %>
        <nav class="collection-breadcrumbs mb-3" aria-label="<%= t('breadcrumbs.collections', default: 'Collections') %>">
          <% if breadcrumb_paths.present? %>
            <% breadcrumb_paths.each do |path| %>
              <%
                last_segment_label = path.last&.dig(:label).to_s.strip
                is_duplicate = has_serial && (
                  last_segment_label.casecmp?(serial_title) ||
                  last_segment_label.downcase.gsub(/[^a-z0-9]/, '') == serial_title.downcase.gsub(/[^a-z0-9]/, '')
                )
              %>
              <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item collection-breadcrumbs__root"><%= link_to root_breadcrumb_label, root_breadcrumb_url %></li>
                <% path.each_with_index do |segment, idx| %>
                  <%
                    is_last_segment = (idx == path.length - 1)
                    active = is_last_segment && (!has_serial || is_duplicate)
                    target_url = (is_last_segment && is_duplicate && parent_url.present?) ? parent_url : helpers.collection_breadcrumb_url(segment[:value], segment[:field])
                  %>
                  <li class="breadcrumb-item <%= 'active' if active %>">
                    <%= link_to segment[:label],
                                target_url,
                                aria: (active ? { current: 'page' } : {}) %>
                  </li>
                <% end %>
                <% if has_serial && !is_duplicate && parent_url.present? %>
                  <li class="breadcrumb-item active">
                    <%= link_to serial_title, parent_url, aria: { current: 'page' } %>
                  </li> 
                <% end %>
              </ol>
            <% end %>
          <% else %>
            <ol class="breadcrumb mb-1">
              <li class="breadcrumb-item collection-breadcrumbs__root"><%= link_to root_breadcrumb_label, root_breadcrumb_url %></li>
              <% if has_serial && parent_url.present? %>
                <li class="breadcrumb-item active">
                  <%= link_to serial_title, parent_url, aria: { current: 'page' } %>
                </li>
              <% end %>
            </ol>
          <% end %>
        </nav>
      <% end %>

      <% is_item_unavailable = (@component == :div) && (@document._source["is_serial"]&.first != "Yes") && @document._source["ark"].blank? %>

      <% if is_item_unavailable %>
        <div class="item-unavailable-404-container text-center pt-0 pb-5 px-3" style="padding-top: 0 !important;">
          <div class="d-flex justify-content-center mb-4">
            <a href="<%= root_breadcrumb_url %>" class="btn btn-primary px-4 py-2" style="border-radius: 3px !important;">
              <i class="bi bi-arrow-left me-1"></i>
              <%= is_fr ? 'Retour à la recherche' : 'Back to Search' %>
            </a>
          </div>

          <h1 class="display-6 fw-bold mb-3 text-dark">
            <%= is_fr ? "404 - Cet élément n'est pas disponible" : "404 - This item is unavailable" %>
          </h1>

          <p class="lead text-muted mx-auto mb-4" style="max-width: 680px;">
            <% doc_title = @document._source['title_tsim']&.first || @document._source['id'] || params[:id] %>
            <% if is_fr %>
              Les images numérisées pour « <strong><%= doc_title %></strong> » ne sont pas disponibles actuellement ou n'ont pas encore été numérisées.
            <% else %>
              The digitized images for “<strong><%= doc_title %></strong>” are currently unavailable or have not yet been digitized.
            <% end %>
          </p>

          <div class="item-unavailable-404-image-wrapper my-4">
            <img src="/assets/404.webp"
                 class="img-fluid rounded border shadow-sm not-found-icon"
                 alt="<%= is_fr ? "Erreur 404 - Cette page est morte | oocihm.8_06911_57.1" : "404 Error - This page is dead | oocihm.8_06911_57.1" %>"
                 style="max-width: 480px; width: 100%; height: auto;" />
            <div class="mt-2 text-muted fst-italic small">
              oocihm.8_06911_57.1 — <%= is_fr ? '« Cette page est morte »' : '« This page is dead »' %>
            </div>
          </div>

          <div class="mt-5 pt-4 border-top mx-auto" style="max-width: 800px;">
            <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#unavailable-item-metadata" aria-expanded="false" aria-controls="unavailable-item-metadata">
              <i class="bi bi-card-text me-1"></i>
              <%= is_fr ? 'Afficher les métadonnées de la notice' : 'View Record Metadata' %>
            </button>
            <div class="collapse mt-3 text-start" id="unavailable-item-metadata">
              <div class="card card-body bg-light border">
                <h4 class="h5 mb-3 text-dark border-bottom pb-2">
                  <%= is_fr ? 'Informations bibliographiques' : 'Bibliographic Information' %>
                </h4>
                <%= metadata %>
              </div>
            </div>
          </div>
        </div>
      <% else %>
        <% if @component == :div %>
          <section class="document-overview" role="region" aria-label="<%= t('blacklight.main.aria.record_overview', default: 'Record overview') %>">
            <%= title %>
            <%= embed %>
            <%= content %>
          </section>
        <% else %>
          <div class="document-overview">
            <%= title %>
            <%= embed %>
            <%= content %>
          </div>
        <% end %>

        <% if @component == :div %>
        <% if @document._source["is_serial"]&.first == "Yes" %>
          <% collection_items_comp = CollectionItemsComponent.new(
               documentId: @document._source['id'] || params[:id],
               page: params[:page] || 1,
               per_page: 12,
               date_from: params[:date_from],
               date_to: params[:date_to]
             ) %>
        <% end %>
        <div id="document-togglable-content" class="container-fluid">
          <div class="row flex-nowrap">
            <!-- Sidebar -->
            <aside id="toggle-menu" class="col" aria-labelledby="details-heading">
              <% expand_record_label = t('blacklight.metadata.expand_record', default: is_fr ? 'Agrandir la notice de métadonnées' : 'Expand metadata record') %>
              <% collapse_record_label = t('blacklight.metadata.collapse_record', default: is_fr ? 'Quitter le plein écran des métadonnées' : 'Exit full screen metadata') %>
              <% resize_record_label = t('blacklight.metadata.resize_record', default: is_fr ? 'Faire glisser pour redimensionner la colonne des métadonnées (double-cliquer pour réinitialiser)' : 'Drag to resize metadata column (double-click to reset)') %>
              <div class="document-sidebar-header">
                <h3 id="details-heading" class="h3 mb-0"><%= t(@document._source["is_serial"]&.first == "Yes" ? 'labels.L_SERIAL_RECORD' : 'labels.L_RECORD') %></h3>
                <button type="button"
                        id="metadata-fullscreen-toggle"
                        class="btn btn-outline-custom btn-sm metadata-expand-btn"
                        aria-expanded="false"
                        aria-controls="toggle-menu"
                        data-expand-label="<%= expand_record_label %>"
                        data-collapse-label="<%= collapse_record_label %>"
                        title="<%= expand_record_label %>"
                        aria-label="<%= expand_record_label %>">
                  <i class="bi bi-arrows-fullscreen" aria-hidden="true"></i>
                </button>
              </div>
              <% if @document._source["is_serial"]&.first == "Yes" %>
                <% issue_count = collection_items_comp&.total_items || collection_items_comp&.total_all_items || 0 %>
                <div class="serial-available-issues mt-2 mb-3">
                  <span class="citation-toolbar-title"><%= t('labels.L_AVAILABLE_ISSUES', default: 'Available Issues') %>:</span>
                  <span class=""><%= number_with_delimiter(issue_count) %></span>
                  <% if params[:date_from].present? || params[:date_to].present? %>
                    <% total_all = collection_items_comp&.total_all_items || issue_count %>
                    <small class="text-muted d-block mt-1">
                      <%= t('labels.L_FILTERED_FROM_TOTAL', default: '(filtered from %{total} total)', total: number_with_delimiter(total_all)) %>
                    </small>
                  <% end %>
                </div>
              <% end %>
              <% if @document._source["is_serial"]&.first != "Yes" %>
                <% has_ocr = Array(@document['notes_tsim']).any? { |n| n.to_s.match?(/OCR|optical character|ROC|reconnaissance optique/i) } || @document['all_text_timv'].present? %>
                <div class="sidebar-full-text-status mt-2 mb-2">
                  <% if has_ocr %>
                    <!--span class="result-chip result-chip--full-text" title="<%= t('blacklight.tools.full_text_available_tooltip') %>">
                      <%= t('blacklight.tools.full_text_available') %>
                    </span-->
                  <% else %>
                    <!-span class="result-chip result-chip--full-text-unavailable" title="<%= t('blacklight.tools.full_text_unavailable_tooltip') %>">
                      <%= t('blacklight.tools.full_text_unavailable') %>
                    </span-->
                  <% end %>
                </div>
              <% end %>
              <div>  
               
                <p class="download-toolbar-title citation-toolbar-title"><%= t('blacklight.tools.citation_label', default: 'Generate Citation') %>:</p>
                <ul class="list-unstyled mb-0">
                  <li>
                    <a class="btn btn-outline-custom btn-sm sidebar-cite-btn"
                       href="/catalogue/<%= params[:id] %>/citation"
                       data-blacklight-modal="trigger"
                       data-turbo="false">
                      <i class="bi bi-quote me-1" aria-hidden="true"></i>
                      <%= t('blacklight.tools.cite') %>
                    </a>
                  </li>
                </ul>

                <% if @document._source["is_serial"]&.first == "No" %>
                  <div>
                    <div class="mt-1 sidebar-downloads" id="download-toolbar" role="region" aria-label="<%= t('blacklight.tools.download_label', default: 'Downloads') %>"
                         data-docid="<%= @document._source['id'] %>"
                         data-arkpath="<%= @document._source['ark'].to_s.gsub('https://n2t.net/ark:/','') %>">
                      <p class="download-toolbar-title"><%= t('blacklight.tools.download_label', default: 'Downloads') %>:</p>
                      <div class="download-actions">
                        <a id="btn-download-img" class="btn btn-outline-custom btn-sm sidebar-download-btn disabled" aria-disabled="true" title="<%= t('blacklight.tools.img_disabled_tooltip') %>">
                          <span class="download-icon-group" aria-hidden="true">
                            <i class="bi bi-download fs-5" aria-hidden="true"></i>
                            <span class="download-kind">IMG</span>
                          </span>
                          <span class="download-label"><%= t('blacklight.tools.download_image_aria') %></span>
                        </a>
                        <a id="btn-download-page" class="btn btn-outline-custom btn-sm sidebar-download-btn disabled" aria-disabled="true" title="<%= t('blacklight.tools.pdf_disabled_tooltip') %>">
                          <span class="download-icon-group" aria-hidden="true">
                            <i class="bi bi-download fs-5" aria-hidden="true"></i>
                            <span class="download-kind">PAGE</span>
                          </span>
                          <span class="download-label"><%= t('blacklight.tools.download_page_pdf_aria') %></span>
                        </a>
                        <a id="btn-download-full" class="btn btn-outline-custom btn-sm sidebar-download-btn disabled" aria-disabled="true" title="<%= t('blacklight.tools.pdf_disabled_tooltip') %>">
                          <span class="download-icon-group" aria-hidden="true">
                            <i class="bi bi-download fs-5" aria-hidden="true"></i>
                            <span class="download-kind">FULL</span>
                          </span>
                          <span class="download-label"><%= t('blacklight.tools.download_full_pdf_aria') %></span>
                        </a>
                      </div>
                      <span id="download-status" class="text-muted small d-inline-flex align-items-center gap-1" aria-live="polite" aria-atomic="true">
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span class="download-status-text"><%= t('blacklight.tools.download_checking') %></span>
                      </span>
                    </div>
                    <script>
                      (function(){
                        const bar = document.getElementById('download-toolbar');
                        if(!bar) return;

                        const docid = bar.dataset.docid;
                        const ark = bar.dataset.arkpath;

                        const full = document.getElementById('btn-download-full');
                        const page = document.getElementById('btn-download-page');
                        const pageImg = document.getElementById('btn-download-img');
                        const status = document.getElementById('download-status');
                        const statusText = status?.querySelector('.download-status-text');
                        const statusSpinner = status?.querySelector('.spinner-border');
                        const checkingText = <%= raw t('blacklight.tools.download_checking', default: 'Checking download availability...').to_json %>;
                        const unavailableText = <%= raw t('blacklight.tools.download_unavailable', default: 'Not available for this page.').to_json %>;
                        const pdfDisabledTooltip = <%= raw t('blacklight.tools.pdf_disabled_tooltip', default: 'Searchable PDFs and text search are unavailable when no OCR (machine-readable text) exists.').to_json %>;
                        const imgDisabledTooltip = <%= raw t('blacklight.tools.img_disabled_tooltip', default: 'Image download is unavailable for this page.').to_json %>;
                        let availabilityRun = 0;

                        function disableLink(el, tooltip) {
                          if (!el) return;
                          el.classList.add('disabled');
                          el.setAttribute('aria-disabled', 'true');
                          el.removeAttribute('href');
                          el.removeAttribute('download');
                          if (tooltip) {
                            el.setAttribute('title', tooltip);
                            const label = el.querySelector('.download-label')?.textContent || '';
                            el.setAttribute('aria-label', `${label}: ${tooltip}`.trim());
                            el.querySelectorAll('*').forEach((child) => {
                              child.setAttribute('title', tooltip);
                            });
                          }
                        }

                        function enableLink(el, href) {
                          if (!el || !href) return;
                          el.href = href;
                          el.classList.remove('disabled');
                          el.removeAttribute('aria-disabled');
                          el.removeAttribute('title');
                          el.removeAttribute('aria-label');
                          el.querySelectorAll('*').forEach((child) => {
                            child.removeAttribute('title');
                          });
                        }

                        function currentPageNum() {
                          const p = parseInt(new URLSearchParams(window.location.search).get('pageNum') || '1', 10);
                          return Number.isFinite(p) && p > 0 ? p : 1;
                        }

                        function setStatus(message, loading) {
                          if (statusText) statusText.textContent = message || '';
                          if (statusSpinner) statusSpinner.hidden = !loading;
                        }

                        function setLinkState(el, href, tooltip) {
                          if (!el || !href) return disableLink(el, tooltip);
                          enableLink(el, href);
                        }

                        function isEnabled(el) {
                          return !!(el && el.getAttribute('href') && !el.classList.contains('disabled'));
                        }

                        function showFinalStatus() {
                          const anyEnabled = [full, page, pageImg].some(isEnabled);
                          setStatus(anyEnabled ? '' : unavailableText, false);
                        }

                        function encodedArkPath() {
                          return String(ark || '').split('/').map(encodeURIComponent).join('/');
                        }

                        function downloadDataUrl() {
                          const params = new URLSearchParams({
                            pageNum: String(currentPageNum()),
                            _: String(Date.now())
                          });
                          return `/dl/${encodeURIComponent(docid)}/${encodedArkPath()}?${params.toString()}`;
                        }

                        async function fetchDownloadData() {
                          const response = await fetch(downloadDataUrl(), {
                            credentials: 'same-origin',
                            cache: 'no-store'
                          });
                          if (!response.ok) throw new Error(`Download metadata failed: ${response.status}`);
                          return response.json();
                        }

                        async function updateForCurrentPage(){
                          const run = ++availabilityRun;

                          setStatus(checkingText, true);
                          disableLink(full, pdfDisabledTooltip);
                          disableLink(page, pdfDisabledTooltip);
                          disableLink(pageImg, imgDisabledTooltip);

                          try {
                            const data = await fetchDownloadData();
                            if (run !== availabilityRun) return;

                            setLinkState(full, data?.docPdfUri, pdfDisabledTooltip);
                            setLinkState(page, data?.pagePdfUri, pdfDisabledTooltip);
                            setLinkState(pageImg, data?.pageImgUri, imgDisabledTooltip);
                            showFinalStatus();
                          } catch (_error) {
                            if (run !== availabilityRun) return;
                            disableLink(full, pdfDisabledTooltip);
                            disableLink(page, pdfDisabledTooltip);
                            disableLink(pageImg, imgDisabledTooltip);
                            setStatus(unavailableText, false);
                          }
                        }

                        function preventDisabledDownload(event) {
                          if (!isEnabled(event.currentTarget)) event.preventDefault();
                        }

                        [full, page, pageImg].forEach((link) => {
                          if (link) link.addEventListener('click', preventDisabledDownload);
                        });

                        updateForCurrentPage();

                        // Listen for navigation events that may change the query string
                        function onLocationChange(){ updateForCurrentPage(); }
                        window.addEventListener('popstate', onLocationChange);
                        window.addEventListener('hashchange', onLocationChange);

                        // Poll for pageNum changes (covers pushState/replaceState navigation in viewer)
                        let lastSearch = window.location.search;
                        setInterval(() => {
                          if (window.location.search !== lastSearch) {
                            lastSearch = window.location.search;
                            onLocationChange();
                          }
                        }, 750);
                      })();
                    </script>
                  </div>
                <% end %>
                 
                <%= metadata %>
                <% metadata_sections.each do |section| %>
                  <%= section %>
                <% end %>

                <ul class="list-unstyled mb-0">
                  <li>
                    <a href="/catalogue/<%= params[:id] %>/librarian_view" data-blacklight-modal="trigger" data-turbo="false">
                      <i class="bi bi-journal-text me-1" aria-hidden="true"></i>
                      <%= t('blacklight.tools.librarian_view') %>
                    </a>
                  </li>
                </ul>

              </div>
              <div class="metadata-resize-handle"
                   role="separator"
                   aria-orientation="vertical"
                   aria-controls="toggle-menu"
                   tabindex="0"
                   title="<%= resize_record_label %>"
                   aria-label="<%= resize_record_label %>"></div>
              <script>
                (function() {
                  const WIDTH_STORAGE_KEY = 'crkn_metadata_sidebar_width';
                  const FULLSCREEN_STORAGE_KEY = 'crkn_metadata_fullscreen';

                  function applySidebarWidthPx(sidebar, wrapper, widthPx) {
                    if (!sidebar || !wrapper) return null;
                    if (window.innerWidth < 992) {
                      sidebar.style.width = '';
                      sidebar.style.maxWidth = '';
                      sidebar.style.minWidth = '';
                      return null;
                    }
                    const wrapperW = wrapper.getBoundingClientRect().width || window.innerWidth;
                    const maxW = Math.max(340, Math.min(760, Math.floor(wrapperW * 0.65)));
                    const clamped = Math.round(Math.max(240, Math.min(maxW, widthPx)));
                    sidebar.style.width = clamped + 'px';
                    sidebar.style.maxWidth = clamped + 'px';
                    sidebar.style.minWidth = clamped + 'px';
                    return clamped;
                  }

                  function setFullscreenState(nextExpanded, persist) {
                    const wrapper = document.getElementById('document-togglable-content');
                    const fullscreenBtn = document.getElementById('metadata-fullscreen-toggle');
                    if (!wrapper || !fullscreenBtn) return;

                    wrapper.classList.toggle('metadata-fullscreen-active', nextExpanded);
                    fullscreenBtn.setAttribute('aria-expanded', String(nextExpanded));

                    const nextLabel = nextExpanded
                      ? (fullscreenBtn.getAttribute('data-collapse-label') || 'Exit full screen metadata')
                      : (fullscreenBtn.getAttribute('data-expand-label') || 'Expand metadata record');
                    fullscreenBtn.setAttribute('title', nextLabel);
                    fullscreenBtn.setAttribute('aria-label', nextLabel);

                    const icon = fullscreenBtn.querySelector('i.bi');
                    if (icon) {
                      icon.className = nextExpanded ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen';
                    }

                    if (persist) {
                      try {
                        localStorage.setItem(FULLSCREEN_STORAGE_KEY, nextExpanded ? '1' : '0');
                      } catch (_e) {}
                    }
                  }

                  function restorePersistedMetadataSize() {
                    const sidebar = document.getElementById('toggle-menu');
                    const wrapper = document.getElementById('document-togglable-content');
                    if (!sidebar || !wrapper) return;

                    try {
                      const savedW = parseInt(localStorage.getItem(WIDTH_STORAGE_KEY) || '', 10);
                      if (Number.isFinite(savedW) && savedW >= 240) {
                        applySidebarWidthPx(sidebar, wrapper, savedW);
                      }
                      const fullscreenBtn = document.getElementById('metadata-fullscreen-toggle');
                      const isFullscreenBtnVisible = fullscreenBtn && window.getComputedStyle(fullscreenBtn).display !== 'none';
                      const savedFullscreen = isFullscreenBtnVisible && localStorage.getItem(FULLSCREEN_STORAGE_KEY) === '1';
                      if (savedFullscreen) {
                        setFullscreenState(true, false);
                      }
                    } catch (_e) {}
                  }

                  // Apply immediately as #toggle-menu renders to avoid layout shift
                  restorePersistedMetadataSize();

                  if (window.__crknMetadataControlsBound) return;
                  window.__crknMetadataControlsBound = true;

                  document.addEventListener('DOMContentLoaded', restorePersistedMetadataSize);
                  document.addEventListener('turbo:load', restorePersistedMetadataSize);
                  window.addEventListener('resize', restorePersistedMetadataSize);

                  document.addEventListener('click', function(e) {
                    const toggleBtn = e.target.closest('.metadata-collapsible__toggle');
                    if (toggleBtn) {
                      e.preventDefault();
                      const container = toggleBtn.closest('.metadata-collapsible');
                      if (!container) return;
                      const preview = container.querySelector('.metadata-collapsible__preview');
                      const full = container.querySelector('.metadata-collapsible__full');
                      const label = toggleBtn.querySelector('.metadata-collapsible__toggle-label');
                      const icon = toggleBtn.querySelector('i.bi');
                      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
                      const nextExpanded = !isExpanded;

                      toggleBtn.setAttribute('aria-expanded', String(nextExpanded));
                      container.classList.toggle('is-expanded', nextExpanded);
                      if (preview) preview.hidden = nextExpanded;
                      if (full) full.hidden = !nextExpanded;
                      if (label) {
                        label.textContent = nextExpanded
                          ? (toggleBtn.getAttribute('data-show-less-text') || 'Show less')
                          : (toggleBtn.getAttribute('data-show-more-text') || 'Show more');
                      }
                      if (icon) {
                        icon.className = nextExpanded ? 'bi bi-chevron-up' : 'bi bi-chevron-down';
                      }
                      return;
                    }

                    const fullscreenBtn = e.target.closest('#metadata-fullscreen-toggle');
                    if (fullscreenBtn) {
                      e.preventDefault();
                      const isExpanded = fullscreenBtn.getAttribute('aria-expanded') === 'true';
                      setFullscreenState(!isExpanded, true);
                    }
                  });

                  document.addEventListener('keydown', function(e) {
                    if (e.key === 'Escape') {
                      const wrapper = document.getElementById('document-togglable-content');
                      if (wrapper && wrapper.classList.contains('metadata-fullscreen-active')) {
                        setFullscreenState(false, true);
                      }
                    }

                    const handle = e.target.closest && e.target.closest('.metadata-resize-handle');
                    if (handle && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
                      e.preventDefault();
                      const sidebar = document.getElementById('toggle-menu');
                      const wrapper = document.getElementById('document-togglable-content');
                      if (!sidebar || !wrapper) return;
                      const currentW = sidebar.getBoundingClientRect().width;
                      const delta = e.key === 'ArrowRight' ? 24 : -24;
                      const applied = applySidebarWidthPx(sidebar, wrapper, currentW + delta);
                      if (applied) {
                        try {
                          localStorage.setItem(WIDTH_STORAGE_KEY, String(applied));
                        } catch (_e) {}
                      }
                    }
                  });

                  let isResizing = false;
                  document.addEventListener('mousedown', function(e) {
                    const handle = e.target.closest('.metadata-resize-handle');
                    if (!handle) return;
                    e.preventDefault();
                    isResizing = true;
                    handle.classList.add('is-dragging');
                    document.body.classList.add('metadata-resizing');
                  });

                  document.addEventListener('mousemove', function(e) {
                    if (!isResizing) return;
                    const sidebar = document.getElementById('toggle-menu');
                    const wrapper = document.getElementById('document-togglable-content');
                    if (!sidebar || !wrapper) return;
                    const rect = sidebar.getBoundingClientRect();
                    const applied = applySidebarWidthPx(sidebar, wrapper, e.clientX - rect.left);
                    if (applied) {
                      try {
                        localStorage.setItem(WIDTH_STORAGE_KEY, String(applied));
                      } catch (_e) {}
                    }
                  });

                  document.addEventListener('mouseup', function() {
                    if (!isResizing) return;
                    isResizing = false;
                    document.body.classList.remove('metadata-resizing');
                    document.querySelectorAll('.metadata-resize-handle.is-dragging').forEach(function(el) {
                      el.classList.remove('is-dragging');
                    });
                  });

                  document.addEventListener('dblclick', function(e) {
                    const handle = e.target.closest('.metadata-resize-handle');
                    if (!handle) return;
                    const sidebar = document.getElementById('toggle-menu');
                    if (!sidebar) return;
                    sidebar.style.width = '';
                    sidebar.style.maxWidth = '';
                    sidebar.style.minWidth = '';
                    try {
                      localStorage.removeItem(WIDTH_STORAGE_KEY);
                    } catch (_e) {}
                  });
                })();
              </script>
            </aside>
            <!-- Main Content -->
            <div id="doc-main" class="col">

              <% if @document._source["is_serial"]&.first == "No" %>
                <% if @document._source["ark"] %>
                  <div id="my-mirador" data-lenis-prevent data-docid="<%= @document._source['ark'] %>"></div>
                  
                <% else %>
                  <img src="/assets/404.webp" class="not-found-icon" alt="<%= is_fr ? "Cette page est morte | oocihm.8_06911_57.1" : "This page is dead | oocihm.8_06911_57.1" %>" />
                  <p>Sorry, there was a problem loading the images for this item.</p>
                <% end %>

                <%= render(::IiifComponent.new(document: @document, term: params[:q])) %>
              <% else %>
                <%= render(collection_items_comp || CollectionItemsComponent.new(
                  documentId: @document._source['id'] || params[:id],
                  page: params[:page] || 1,
                  per_page: 12,
                  date_from: params[:date_from],
                  date_to: params[:date_to]
                )) %>
              <% end %>
            </div>
          </div>
        </div>



      <% else %>
        <%= metadata %>
        <% metadata_sections.each do |section| %>
          <%= section %>
        <% end %>
        <%= thumbnail %>
        <%= render(::PageSearchComponent.new(docId: @document._source["id"] , arkUrl: @document._source["ark"], term: params[:q])) %>
      <% end %>
      <% end %>

      <br/>
      <% partials.each do |partial| %>
        <%= partial %>
      <% end %>
    </div>
  <% end %>

  <%= footer %>
<% end %>
