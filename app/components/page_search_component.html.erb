<% if render? %>
  <div class="page-search-res-wrap">
    <div class="page-search-header d-flex align-items-center gap-2 mb-1">
      <span class="matching-image-label">
        <%= t('blacklight.page_search.matching_pages_for_html', term: @term) %>
      </span>
    </div>

    <div class="page-search-body">
      <div class="page-chip-list" role="list">
        <% matching_pages.first(24).each do |page_num| %>
          <%= link_to page_num,
                      "/catalogue/#{ERB::Util.url_encode(@document_id)}?pageNum=#{page_num}&q=#{ERB::Util.url_encode(@term)}",
                      class: "chip page-chip",
                      role: "listitem",
                      aria: { label: t('blacklight.page_search.go_to_page_aria', page: page_num) } %>
        <% end %>
        <% if matching_pages.length > 24 %>
          <span class="page-search-more" hidden>
            <% matching_pages.drop(24).each do |page_num| %>
              <%= link_to page_num,
                          "/catalogue/#{ERB::Util.url_encode(@document_id)}?pageNum=#{page_num}&q=#{ERB::Util.url_encode(@term)}",
                          class: "chip page-chip",
                          role: "listitem",
                          aria: { label: t('blacklight.page_search.go_to_page_aria', page: page_num) } %>
            <% end %>
          </span>
        <% end %>
      </div>
      <% if matching_pages.length > 24 %>
        <div class="page-search-togglebar mt-2">
          <button type="button"
                  class="btn btn-link btn-sm page-search-toggle p-0"
                  data-label-more="<%= t('blacklight.page_search.show_more') %>"
                  data-label-less="<%= t('blacklight.page_search.show_less', default: 'Show less') %>">
            <i class="bi bi-chevron-down" aria-hidden="true"></i>
            <span><%= t('blacklight.page_search.show_more') %></span>
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
